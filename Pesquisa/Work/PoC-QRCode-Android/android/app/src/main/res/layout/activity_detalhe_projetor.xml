<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textStatusDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <ImageView
            android:id="@+id/imageViewQrDetalhe"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_qr_generico" />

        <TextView
            android:id="@+id/textInfoAlugado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRegistrarDevolucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar devolução"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/formAluguel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/fieldLocatario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome do locatário" />

            <EditText
                android:id="@+id/fieldTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telefone (opcional)"
                android:inputType="phone" />

            <EditText
                android:id="@+id/fieldDataDevolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Devolução prevista (ex: 30/09/2026)" />

            <Button
                android:id="@+id/btnRegistrarAluguel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Registrar aluguel" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
