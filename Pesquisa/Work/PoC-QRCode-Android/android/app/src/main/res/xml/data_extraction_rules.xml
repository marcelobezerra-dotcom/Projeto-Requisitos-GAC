<?xml version="1.0" encoding="utf-8"?>
<!--
  A lista de projetores guarda nome e telefone de quem alugou. Nada disso pode
  sair do aparelho por backup na nuvem nem por transferência de dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
