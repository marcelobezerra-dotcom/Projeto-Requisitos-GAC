# Modelo de configuracao de assinatura.
#
# Copie este arquivo para keystore.properties e preencha com os seus valores.
# O keystore.properties real esta no .gitignore e NAO deve ser versionado —
# ele contem as senhas do keystore de release.
#
# Sem este arquivo o build release ainda funciona, mas cai para a assinatura
# de debug (nao serve para distribuir).
storeFile=keystore/seu-keystore-release.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=seu-alias
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
